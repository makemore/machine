name: win-dev

os: windows
packageManager: choco

resources:
  cpu: 4
  memory: 8gb

setup:
  - install: git
  - install: python
  - install: nodejs
  - clone:
      repo: https://github.com/octocat/Hello-World
      dest: C:\Users\User\hello-world

run:
  - cmd: python --version
  - cmd: node --version

expose:
  - 3389
  - 8080
