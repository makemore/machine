name: full-stack

os: linux
provider: lima
harden: true
swap: 2gb

resources:
  cpu: 4
  memory: 8gb
  disk: 30gb

setup:
  - install: git curl build-essential
  - install: docker
  - install: postgres
  - install: nodejs-22
  - cmd: npm install -g typescript

expose:
  - 3000
  - 5432
  - 8000

reverse_proxy:
  routes:
    - path: /api/*
      target: localhost:8000
    - path: /
      target: localhost:3000

motd: |
  Full Stack Dev Environment: {{.Name}}
  Node.js + PostgreSQL + Docker
