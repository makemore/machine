name: python-dev

os: linux
provider: lima
swap: 2gb

resources:
  cpu: 4
  memory: 4gb

setup:
  - install: git curl python3 python3-dev build-essential
  - cmd: curl -LsSf https://astral.sh/uv/install.sh | sh
  - clone:
      repo: https://github.com/octocat/Hello-World
      dest: /home/lima.linux/hello-world

expose:
  - 8000

motd: |
  Python Dev Environment: {{.Name}}
